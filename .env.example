# Supabase — set these in .env.local (local dev) or Vercel env vars (production)
# Both values are safe to expose client-side (anon/publishable key only — no service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic — server-side only, NEVER expose in client code
# Set in Vercel dashboard for production; use `vercel dev` locally
ANTHROPIC_API_KEY=